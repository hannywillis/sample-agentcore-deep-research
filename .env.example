# =============================================================================
# Evidence-Grounded & Context-Aware Agricultural Decision Support (agri_advisor)
# Copy to `.env` (git-ignored) and adjust. Every value has a safe offline default
# so the platform runs end-to-end with NO API keys (extractive mode).
# =============================================================================

# ---------------------------------------------------------------------------
# LLM - NLP knowledge translation (WP1)
#   none     -> offline extractive mode (no translation, English output + note)
#   bedrock  -> Amazon Bedrock Converse API (uses AWS credentials below)
#   openai   -> any OpenAI-compatible endpoint (OpenAI, Azure, vLLM, Ollama...)
# ---------------------------------------------------------------------------
LLM_PROVIDER=none
LLM_MODEL_ID=global.anthropic.claude-sonnet-5
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900

# AWS (Bedrock LLM / Titan embeddings / AgentCore deployment)
AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Embeddings & vector store - RAG knowledge base (WP1)
#   hashing               -> dependency-free, offline (default, for dev/tests)
#   sentence-transformers -> multilingual dense model (recommended for pilots)
#   bedrock               -> Amazon Titan text embeddings
# Changing provider/model requires: python -m agri_advisor.rag.ingest --rebuild
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=768
VECTOR_STORE_PATH=.agri_store
KNOWLEDGE_BASE_DIR=data/knowledge_base
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.12

# ---------------------------------------------------------------------------
# Predictive intelligence (WP2)
# ---------------------------------------------------------------------------
MODEL_DIR=.agri_models
# Train SYNTHETIC scaffold models on first use if none exist (dev only!)
AUTO_TRAIN_SCAFFOLD_MODELS=true
# Miscoverage for split-conformal intervals (0.1 -> 90 % prediction intervals)
CONFORMAL_ALPHA=0.1

# ---------------------------------------------------------------------------
# Expert validation & data governance (WP1)
#   roles: public | extension | consortium | data_owner
# ---------------------------------------------------------------------------
EXPERT_VALIDATION_CONFIG=config/expert_validation.yaml
EXPERT_REVIEW_QUEUE=.agri_store/expert_review_queue.jsonl
DEFAULT_ACCESS_ROLE=public

# ---------------------------------------------------------------------------
# Language & tiered access interface (WP3)
#   languages: en | sw | fr | ha | pt | dje (Zarma - falls back to fr phrases)
# ---------------------------------------------------------------------------
DEFAULT_LANGUAGE=en
SMS_MAX_CHARS=459
USSD_MAX_CHARS=182
VOICE_MAX_ITEMS=3

# ---------------------------------------------------------------------------
# Underlying AgentCore deep-research agent (patterns/strands-deep-research)
# ---------------------------------------------------------------------------
# AGRI_MODE=true                 # enable agri tools + agri system prompt
# STACK_NAME=agentcore-deep-research
# MEMORY_ID=
# MODEL_ID=global.anthropic.claude-sonnet-5
# TOOLS_CONFIG=tavily,arxiv,bedrock_kb,agri
# STAGING_BUCKET_NAME=
